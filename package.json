{
  "name": "cans-spec",
  "version": "0.4.0",
  "description": "Canonical Agent-Native Spec — the outline is the spec, the state, and the task board",
  "bin": {
    "cans": "./bin/cans.js"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=23.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && bun test"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cans",
    "spec",
    "spec-driven",
    "agents",
    "agent-native",
    "ai",
    "markdown",
    "outline"
  ],
  "author": "cans-hq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cans-hq/cans-spec.git"
  },
  "bugs": {
    "url": "https://github.com/cans-hq/cans-spec/issues"
  },
  "homepage": "https://github.com/cans-hq/cans-spec#readme",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/bun": "^1.1.0"
  }
}
